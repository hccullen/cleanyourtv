<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Your Home Assistant server, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- A remote button mapped to this (the launcher's app_keys, "scan:<code>:io.github.maxhayim.smarthome/.QuickActivity")
             runs the pushed config's "quick" entity on Home Assistant. Nothing on screen but a toast. -->
        <activity
            android:name=".QuickActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- install.sh writes the server address and token here with `content write`, so the token never sits on
             a command line. Write-only, one file name, and only the ADB shell may call it. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- The Home panel's now-playing row, read by the launcher when config.xml's panel_packages names this
             app. One query path ("lines"), read-only. The authority is what the launcher's meta-data lookup
             resolves, and the launcher verifies the provider belongs to the package it named. -->
        <provider
            android:name=".PanelProvider"
            android:authorities="${applicationId}.panel"
            android:exported="true" />

        <!-- The authority the launcher resolves for this app's panel rows (PanelPill). -->
        <meta-data android:name="com.gathin.tvhome.panel" android:value="${applicationId}.panel" />
    </application>
</manifest>
